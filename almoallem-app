<!-- ============== LOGIN ============== -->
<div id="loginScreen" class="screen active">
  <div class="logo-badge">م</div>
  <div style="font-size:18px;font-weight:900;margin-bottom:4px;">أهلاً بيك في المعلم</div>
  <div style="font-size:11.5px;color:var(--muted);margin-bottom:22px;">سجّل برقم موبايلك وابدأ تصفح الكتالوج فورًا</div>
  <input type="tel" id="loginPhone" class="login-input" placeholder="01xxxxxxxxx" style="direction:ltr;" maxlength="11">
  <button class="btn-primary" id="loginBtn" disabled onclick="doLogin()">دخول وتصفح الكتالوج</button>
