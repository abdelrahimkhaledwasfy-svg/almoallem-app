    <div id="brandsGrid" class="brand-grid"></div>
  </div>

  <!-- CATEGORY PRODUCTS -->
  <div id="categoryScreen" class="screen">
    <div class="header-row">
      <button class="back-btn" onclick="switchScreen('brands')"><i class="fas fa-arrow-right"></i></button>
      <div class="header-title" id="categoryScreenTitle">الأصناف</div>
    </div>
