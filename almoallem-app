<div id="loadingOverlay" class="hidden" style="position:fixed;inset:0;background:var(--cream);z-index:200;display:flex;align-items:center;justify-content:center;flex-direction:column;">
  <div class="spinner"></div>
  <div style="font-size:11px;color:var(--muted);">جاري التحميل...</div>
</div>

<div id="toast"></div>

<script>
/* =========================================================================
   إعدادات Firebase — نفس مشروع نظام المعلم بالظبط (بيانات + مخزون متزامنين)
   ========================================================================= */
const firebaseConfig = {
    apiKey: "AIzaSyCypCZMxYLYCOtQZSCVdQFdf1STPxBKzlc",
    authDomain: "almoallem-system.firebaseapp.com",
    projectId: "almoallem-system",
    storageBucket: "almoallem-system.firebasestorage.app",
    messagingSenderId: "451766637006",
    appId: "1:451766637006:web:f4a727eb92ef24df0fdb9f",
    measurementId: "G-C5HBP932YR"
};
firebase.initializeApp(firebaseConfig);
const db = firebase.firestore();

/* =========================================================================
   الحالة العامة
   ========================================================================= */
let products = [], appCategories = [], appBrands = [], appBanners = [], appOffers = [];
let stockLevels = {}; // { productCode: qty }
let cart = JSON.parse(localStorage.getItem('app_cart') || '{}'); // {code: {unit, qty}}
let favorites = JSON.parse(localStorage.getItem('app_favorites') || '[]');
let customerPhone = localStorage.getItem('app_customer_phone') || null;
let customerProfile = JSON.parse(localStorage.getItem('app_customer_profile') || 'null');
let lastOrderItems = JSON.parse(localStorage.getItem('app_last_order') || 'null');
let myOrders = [];
let activeCatId = null, activeBrandName = null;
let adIndex = 0, adTimer = null;
let deliveryTime = 'morning';
let currentRatingOrderId = null, currentRatingStars = 5;
const MIN_ORDER_AMOUNT = 100;

function money(n){ return (n||0).toLocaleString('ar-EG',{minimumFractionDigits:2,maximumFractionDigits:2}); }
function showToast(msg, ms){
    const t = document.getElementById('toast');
    t.textContent = msg; t.classList.add('show');
    setTimeout(()=>t.classList.remove('show'), ms || 1800);
}
function showLoading(v){ document.getElementById('loadingOverlay').classList.toggle('hidden', !v); }

/* =========================================================================
   تسجيل الدخول (رقم الموبايل فقط)
   ========================================================================= */
document.getElementById('loginPhone').addEventListener('input', function(){
    document.getElementById('loginBtn').disabled = this.value.trim().length < 10;
});
function doLogin(){
    const phone = document.getElementById('loginPhone').value.trim();
    if (phone.length < 10) return;
    customerPhone = phone;
    localStorage.setItem('app_customer_phone', phone);
    // لو فيه بروفايل محفوظ محليًا لنفس الرقم، نحمّله؛ غير كده هيتطلب عند أول طلب
    startApp();
}
function doLogout(){
    if (!confirm('تسجيل الخروج؟')) return;
    localStorage.removeItem('app_customer_phone');
    location.reload();
}

/* =========================================================================
   بدء التطبيق + الاستماع اللحظي لبيانات نظام المعلم
   ========================================================================= */
function startApp(){
    document.getElementById('loginScreen').classList.remove('active');
    document.getElementById('appRoot').classList.remove('hidden');
    document.getElementById('welcomeName').textContent = customerProfile?.customerName || ('عميل ' + customerPhone);
    document.getElementById('accountCustomerName').textContent = customerProfile?.customerName || 'بيانات غير مكتملة بعد';
    document.getElementById('accountPhone').textContent = customerPhone;
    showLoading(true);
    listenToStoreData();
    listenToStockLevels();
    listenToMyOrders();
    updateCartBadge();
}

function listenToStoreData(){
    db.collection('storeData').doc('main').onSnapshot(function(doc){
        if (!doc.exists) { showLoading(false); return; }
        const data = doc.data();
        products = (data.products || []).filter(p => p.showInApp !== false);
        appCategories = (data.appCategories || []).filter(c => c.active !== false).sort((a,b)=>a.order-b.order);
        appBrands = (data.appBrands || []).filter(b => b.active !== false);
        appBanners = (data.appBanners || []).filter(b => b.active !== false).sort((a,b)=>a.order-b.order);
        appOffers = (data.appOffers || []).filter(o => o.active !== false && (!o.endDate || new Date(o.endDate) >= new Date()));
        const custPoints = (data.customers || []).find(c => c.code === customerPhone)?.loyaltyPoints || 0;
        document.getElementById('accountPoints').textContent = custPoints;
        renderHome();
        renderAdBanners();
        showLoading(false);
    }, function(err){
        console.error(err);
        showLoading(false);
        showToast('تعذر الاتصال بالسيرفر، تأكد من الإنترنت');
    });
}

function listenToStockLevels(){
    db.collection('stockLevels').onSnapshot(function(snap){
        stockLevels = {};
        snap.forEach(doc => { stockLevels[doc.id] = doc.data().qty || 0; });
        renderHome();
        if (document.getElementById('categoryScreen').classList.contains('active')) renderCategoryProducts();
        if (document.getElementById('searchScreen').classList.contains('active')) renderSearchResults();
        if (document.getElementById('favoritesScreen').classList.contains('active')) renderFavorites();
    });
}

function getStock(code){ return stockLevels.hasOwnProperty(code) ? stockLevels[code] : 999; }

function listenToMyOrders(){
    if (!customerPhone) return;
    db.collection('customerOrders').where('customerCode', '==', customerPhone).orderBy('createdAt', 'desc').onSnapshot(function(snap){
        myOrders = snap.docs.map(d => Object.assign({ id: d.id }, d.data()));
        renderOrders();
    }, function(err){ console.error('orders listener error', err); });
}

/* =========================================================================
   التنقل بين الشاشات
   ========================================================================= */
function switchScreen(name){
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
    document.getElementById(name + 'Screen').classList.add('active');
    document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
    if (name === 'home') document.getElementById('navHome').classList.add('active');
    if (name === 'offers') document.getElementById('navOffers').classList.add('active');
    if (name === 'cart') { document.getElementById('navCart').classList.add('active'); renderCart(); }
    if (name === 'favorites') renderFavorites();
    if (name === 'offers') renderOffers();
    if (name === 'confirm') renderConfirm();
    window.scrollTo(0,0);
}
function switchTopTab(tab){
    document.querySelectorAll('.top-tab').forEach(b => b.classList.toggle('active', b.dataset.toptab === tab));
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
    if (tab === 'home') { document.getElementById('homeScreen').classList.add('active'); document.getElementById('navHome').classList.add('active'); }
    else if (tab === 'orders') { document.getElementById('ordersScreen').classList.add('active'); renderOrders(); }
    else if (tab === 'account') { document.getElementById('accountScreen').classList.add('active'); document.getElementById('navAccount').classList.add('active'); }
    document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
    if (tab === 'home') document.getElementById('navHome').classList.add('active');
    if (tab === 'account') document.getElementById('navAccount').classList.add('active');
}

/* =========================================================================
   عرض الرئيسية: الأقسام + الأكثر طلبًا
   ========================================================================= */
function categoryIconHtml(cat){
    if (cat.imageUrl) return `<img src="${cat.imageUrl}" class="cat-img">`;
    return `<div class="cat-icon"><i class="fas fa-box"></i></div>`;
}
function renderHome(){
    const grid = document.getElementById('categoriesGrid');
    if (appCategories.length === 0){
        grid.innerHTML = `<div class="empty-note" style="grid-column:1/-1;">لسه مفيش أقسام مضافة من المعلم</div>`;
    } else {
        grid.innerHTML = appCategories.map(c => `
            <button class="cat-tile" onclick="openCategory('${c.id}')">
                ${categoryIconHtml(c)}
                <div class="cat-name">${c.name}</div>
            </button>`).join('');
    }
    const bestRow = document.getElementById('bestSellersRow');
    const best = products.slice(0, 8);
    bestRow.innerHTML = best.length ? best.map(p => productCardHtml(p)).join('') : `<div class="empty-note">لسه مفيش أصناف مضافة</div>`;
}

function renderAdBanners(){
    const wrap = document.getElementById('adBannerWrap');
    clearInterval(adTimer);
    if (appBanners.length === 0){ wrap.innerHTML = ''; return; }
    adIndex = 0;
    drawAdBanner();
    adTimer = setInterval(() => { adIndex = (adIndex + 1) % appBanners.length; drawAdBanner(); }, 4000);
}
function drawAdBanner(){
    const b = appBanners[adIndex];
    const wrap = document.getElementById('adBannerWrap');
    const bg = b.imageUrl ? `background-image:linear-gradient(135deg, rgba(122,31,31,0.55), rgba(94,20,20,0.75)), url('${b.imageUrl}');background-size:cover;background-position:center;`
                          : `background:linear-gradient(135deg, var(--maroon), var(--maroon-dark));`;
    wrap.innerHTML = `
        <button class="ad-banner" style="${bg}width:calc(100% - 32px);margin:14px 16px 0;" onclick="handleBannerClick(${adIndex})">
            <div class="ad-title">${b.title}</div>
            ${b.subtitle ? `<div class="ad-sub">${b.subtitle}</div>` : ''}
        </button>
        <div class="ad-dots">${appBanners.map((_,i)=>`<div class="ad-dot ${i===adIndex?'active':''}"></div>`).join('')}</div>`;
}
function handleBannerClick(i){
    const b = appBanners[i];
    if (b.linkType === 'category') { const cat = appCategories.find(c => c.name === b.linkValue); if (cat) openCategory(cat.id); }
    else if (b.linkType === 'product') { switchScreen('search'); document.getElementById('searchInput').value = ''; }
}

/* =========================================================================
   الأقسام → الشركات → المنتجات
   ========================================================================= */
function openCategory(catId){
    activeCatId = catId; activeBrandName = null;
    const cat = appCategories.find(c => c.id === catId);
    document.getElementById('brandsScreenTitle').textContent = (cat?.name || '') + ' — الشركات';
    const brandsInCat = appBrands.filter(b => b.categoryName === cat?.name);
    const grid = document.getElementById('brandsGrid');
    let html = `<button class="brand-tile all" onclick="openCategoryProducts(null)">
        <div class="brand-logo-fallback" style="background:rgba(255,255,255,0.15);color:#FBF3E7;"><i class="fas fa-layer-group"></i></div>
        <div class="brand-name">كل الأصناف</div></button>`;
    brandsInCat.forEach(b => {
        const count = products.filter(p => p.category === cat?.name && p.brand === b.name).length;
        html += `<button class="brand-tile" onclick="openCategoryProducts('${b.name.replace(/'/g,"\\'")}')">
            ${b.logoUrl ? `<img src="${b.logoUrl}" class="brand-logo">` : `<div class="brand-logo-fallback">${b.name.slice(0,2)}</div>`}
            <div class="brand-name">${b.name}</div><div class="brand-count">${count} صنف</div></button>`;
    });
    grid.innerHTML = html;
    switchScreen('brands');
}
function openCategoryProducts(brandName){
    activeBrandName = brandName;
    const cat = appCategories.find(c => c.id === activeCatId);
    document.getElementById('categoryScreenTitle').textContent = cat?.name || 'الأصناف';
    const brandsInCat = appBrands.filter(b => b.categoryName === cat?.name);
    const pillsWrap = document.getElementById('categoryBrandPills');
    pillsWrap.innerHTML = `<button class="pill ${!activeBrandName?'active':''}" onclick="openCategoryProducts(null)">الكل</button>` +
        brandsInCat.map(b => `<button class="pill ${activeBrandName===b.name?'active':''}" onclick="openCategoryProducts('${b.name.replace(/'/g,"\\'")}')">${b.name}</button>`).join('');
    renderCategoryProducts();
    switchScreen('category');
}
function renderCategoryProducts(){
    const cat = appCategories.find(c => c.id === activeCatId);
    let list = products.filter(p => p.category === cat?.name && (!activeBrandName || p.brand === activeBrandName));
    const sort = document.getElementById('sortSelect').value;
    if (sort === 'priceAsc') list = [...list].sort((a,b)=>a.price-b.price);
    else if (sort === 'priceDesc') list = [...list].sort((a,b)=>b.price-a.price);
    const grid = document.getElementById('categoryProductsGrid');
    grid.innerHTML = list.length ? list.map(p => productCardHtml(p)).join('') : `<div class="empty-note" style="grid-column:1/-1;">لا توجد أصناف حاليًا</div>`;
}

/* =========================================================================
   البحث والمفضلة
   ========================================================================= */
function renderSearchResults(){
    const q = document.getElementById('searchInput').value.trim();
    const grid = document.getElementById('searchResultsGrid');
    if (!q){ grid.innerHTML = `<div class="empty-note" style="grid-column:1/-1;">اكتب اسم الصنف أو الشركة عشان تبدأ البحث</div>`; return; }
    const results = products.filter(p => p.name.includes(q) || (p.brand||'').includes(q));
    grid.innerHTML = results.length ? results.map(p => productCardHtml(p)).join('') : `<div class="empty-note" style="grid-column:1/-1;">مفيش نتائج مطابقة لـ "${q}"</div>`;
}
function toggleFavorite(code){
    const idx = favorites.indexOf(code);
    if (idx === -1) favorites.push(code); else favorites.splice(idx,1);
    localStorage.setItem('app_favorites', JSON.stringify(favorites));
    renderHome();
    if (document.getElementById('categoryScreen').classList.contains('active')) renderCategoryProducts();
    if (document.getElementById('searchScreen').classList.contains('active')) renderSearchResults();
    if (document.getElementById('favoritesScreen').classList.contains('active')) renderFavorites();
}
function renderFavorites(){
    const grid = document.getElementById('favoritesGrid');
    const list = products.filter(p => favorites.includes(p.code));
    grid.innerHTML = list.length ? list.map(p => productCardHtml(p)).join('')
        : `<div class="empty-note" style="grid-column:1/-1;">مفيش أصناف في المفضلة لسه<br>دوس على النجمة فوق أي صنف عشان تضيفه هنا</div>`;
}

/* =========================================================================
   العروض
   ========================================================================= */
function renderOffers(){
    const wrap = document.getElementById('offersList');
    if (appOffers.length === 0){ wrap.innerHTML = `<div class="empty-note">لا توجد عروض حاليًا</div>`; return; }
    wrap.innerHTML = appOffers.map(o => {
        const p = products.find(x => x.code === o.productCode);
        const discount = o.oldPrice > 0 ? Math.round((1 - o.newPrice/o.oldPrice)*100) : 0;
        return `<div style="background:var(--card);border:1px solid var(--border);border-radius:18px;padding:12px;display:flex;gap:10px;align-items:center;margin-bottom:10px;">
            <div style="width:56px;height:56px;border-radius:14px;background:var(--sand);display:flex;align-items:center;justify-content:center;color:var(--maroon);font-size:20px;flex-shrink:0;">
                <i class="fas fa-tag"></i>
            </div>
            <div style="flex:1;min-width:0;">
                <div style="font-size:11.5px;font-weight:800;">${o.title}</div>
                ${o.desc ? `<div style="font-size:9.5px;color:var(--muted);margin-top:2px;">${o.desc}</div>` : ''}
                <div style="display:flex;align-items:center;gap:6px;margin-top:5px;">
                    ${discount>0 ? `<span style="font-size:9.5px;text-decoration:line-through;color:#B7A88E;">${money(o.oldPrice)}</span>` : ''}
                    <span style="font-size:13px;font-weight:900;color:var(--maroon);">${money(o.newPrice)} ج.م</span>
                </div>
            </div>
            <button style="font-size:10px;font-weight:800;padding:8px 14px;border-radius:12px;background:var(--maroon);color:var(--cream);flex-shrink:0;"
                onclick="${p ? `openCategoryFromOffer('${(p.category||'').replace(/'/g,"\\'")}')` : ''}">اطلب</button>
        </div>`;
    }).join('');
}
function openCategoryFromOffer(categoryName){
    const cat = appCategories.find(c => c.name === categoryName);
    if (cat) openCategory(cat.id); else switchScreen('search');
}

/* =========================================================================
   كارت المنتج (HTML مشترك لكل الشاشات)
   ========================================================================= */
function productCardHtml(p){
    const stock = getStock(p.code);
    const oos = stock <= 0;
    const low = !oos && stock <= 5;
    const entry = cart[p.code];
    const isSecondary = entry && entry.unit === 'secondary';
    const unitLabel = isSecondary ? p.secondaryUnit?.name : p.unit;
    const unitPrice = isSecondary ? p.secondaryUnit?.price : p.price;
    const isFav = favorites.includes(p.code);
    const imgHtml = p.imageUrl ? `<img src="${p.imageUrl}" class="pcard-img">` : `<div class="pcard-img-fallback"><i class="fas fa-box-open"></i></div>`;

    let stepperHtml;
    if (!entry || !entry.qty){
        stepperHtml = `<button class="pcard-add" ${oos?'disabled':''} onclick="addToCart('${p.code}','primary',1)"><i class="fas fa-plus"></i></button>`;
    } else {
        stepperHtml = `<div class="pcard-stepper">
            <button onclick="addToCart('${p.code}','${entry.unit}',${entry.qty-1})"><i class="fas fa-minus"></i></button>
            <span class="qty">${entry.qty}</span>
            <button onclick="addToCart('${p.code}','${entry.unit}',${entry.qty+1})"><i class="fas fa-plus"></i></button>
        </div>`;
    }

    let unitsHtml = '';
    if (p.secondaryUnit){
        unitsHtml = `<div class="pcard-units">
            <button class="pcard-unit-btn ${!isSecondary?'active':''}" onclick="addToCart('${p.code}','primary',${entry&&!isSecondary?entry.qty:1})">${p.unit}</button>
            <button class="pcard-unit-btn ${isSecondary?'active':''}" onclick="addToCart('${p.code}','secondary',${entry&&isSecondary?entry.qty:1})">${p.secondaryUnit.name}</button>
        </div>`;
    }

    return `<div class="pcard ${oos?'oos':''}">
        <button class="pcard-fav ${isFav?'active':''}" onclick="toggleFavorite('${p.code}')"><i class="fa${isFav?'s':'r'} fa-star"></i></button>
        <div class="pcard-img-wrap">
            ${imgHtml}
            ${oos ? `<div class="pcard-badge oos">غير متوفر</div>` : (low ? `<div class="pcard-badge low">كمية محدودة</div>` : '')}
            ${stepperHtml}
        </div>
        <div class="pcard-body">
            <div class="pcard-price">${money(unitPrice)}<span class="cur">ج.م</span></div>
            <div class="pcard-unit">لكل ${unitLabel}</div>
            <div class="pcard-name">${p.name}</div>
            ${unitsHtml}
        </div>
    </div>`;
}

function addToCart(code, unit, qty){
    const p = products.find(x => x.code === code);
    if (!p) return;
    const stock = getStock(code);
    if (stock <= 0) return;
    const maxUnit = unit === 'secondary' ? (p.maxOrderQty||99) * (p.secondaryUnit?.factor||1) : (p.maxOrderQty || 99);
    qty = Math.max(0, Math.min(qty, maxUnit));
    if (qty <= 0) delete cart[code]; else cart[code] = { unit, qty };
    localStorage.setItem('app_cart', JSON.stringify(cart));
    updateCartBadge();
    renderHome();
    if (document.getElementById('categoryScreen').classList.contains('active')) renderCategoryProducts();
    if (document.getElementById('searchScreen').classList.contains('active')) renderSearchResults();
    if (document.getElementById('favoritesScreen').classList.contains('active')) renderFavorites();
    if (document.getElementById('cartScreen').classList.contains('active')) renderCart();
}

function updateCartBadge(){
    const count = Object.values(cart).reduce((s,e)=>s+e.qty,0);
    const badge = document.getElementById('navCartBadge');
    if (count > 0){ badge.textContent = count; badge.classList.remove('hidden'); } else badge.classList.add('hidden');
}

function getCartLineItems(){
    return Object.entries(cart).map(([code, entry]) => {
        const p = products.find(x => x.code === code);
        if (!p) return null;
        const isSecondary = entry.unit === 'secondary';
        const unitPrice = isSecondary ? p.secondaryUnit?.price : p.price;
        const unitLabel = isSecondary ? p.secondaryUnit?.name : p.unit;
        return { product: p, entry, unitPrice, unitLabel, lineTotal: unitPrice * entry.qty };
    }).filter(Boolean);
}
function getCartTotal(){ return getCartLineItems().reduce((s,l)=>s+l.lineTotal,0); }

/* =========================================================================
   السلة
   ========================================================================= */
function renderCart(){
    const lines = getCartLineItems();
    const wrap = document.getElementById('cartItemsWrap');
    if (lines.length === 0){
        wrap.innerHTML = `<div class="empty-note">السلة فارغة</div>`;
        return;
    }
    let html = lines.map(l => `
        <div class="cart-item">
            ${l.product.imageUrl ? `<img src="${l.product.imageUrl}">` : `<div class="fallback"><i class="fas fa-box-open"></i></div>`}
            <div class="cart-item-info">
                <div class="cart-item-name">${l.product.name}</div>
                <div class="cart-item-unit">${l.unitLabel}</div>
                <div class="cart-stepper">
                    <button onclick="addToCart('${l.product.code}','${l.entry.unit}',${l.entry.qty-1})"><i class="fas fa-minus"></i></button>
                    <span style="font-weight:800;font-size:11px;">${l.entry.qty}</span>
                    <button onclick="addToCart('${l.product.code}','${l.entry.unit}',${l.entry.qty+1})"><i class="fas fa-plus"></i></button>
                </div>
            </div>
            <div class="cart-item-price">${money(l.lineTotal)}</div>
            <button class="cart-item-remove" onclick="addToCart('${l.product.code}','${l.entry.unit}',0)"><i class="fas fa-trash"></i></button>
        </div>`).join('');

    const total = getCartTotal();
    const belowMin = total < MIN_ORDER_AMOUNT;
    html += `<div style="height:140px;"></div>
        <div class="cart-footer">
            ${belowMin ? `<div style="font-size:10.5px;font-weight:800;color:var(--danger);text-align:center;margin-bottom:8px;">الحد الأدنى للطلب ${MIN_ORDER_AMOUNT} ج.م — ناقصك ${money(MIN_ORDER_AMOUNT-total)} ج.م كمان</div>` : ''}
            <div style="display:flex;justify-content:space-between;font-size:11.5px;margin-bottom:8px;"><span>الإجمالي</span><span style="font-weight:900;">${money(total)} ج.م</span></div>
            <button class="btn-primary" ${belowMin?'disabled':''} onclick="switchScreen('confirm')">متابعة الطلب</button>
        </div>`;
    wrap.innerHTML = html;
}

function applyLastOrder(){
    if (!lastOrderItems || Object.keys(lastOrderItems).length === 0){ showToast('لا يوجد طلب سابق'); return; }
    cart = JSON.parse(JSON.stringify(lastOrderItems));
    localStorage.setItem('app_cart', JSON.stringify(cart));
    updateCartBadge();
    showToast('تم استرجاع آخر طلب');
    switchScreen('cart');
}

/* =========================================================================
   تأكيد الطلب + استكمال البروفايل عند أول طلب
   ========================================================================= */
function renderConfirm(){
    const lines = getCartLineItems();
    document.getElementById('confirmSummary').innerHTML = `
        <div style="background:var(--card);border:1px solid var(--border);border-radius:16px;padding:14px;">
            <div style="font-size:11.5px;font-weight:800;margin-bottom:8px;">ملخص الطلب (${lines.reduce((s,l)=>s+l.entry.qty,0)} صنف)</div>
            ${lines.map(l => `<div style="display:flex;justify-content:space-between;font-size:10.5px;padding:4px 0;color:#5B4432;"><span>${l.product.name} × ${l.entry.qty}</span><span>${money(l.lineTotal)} ج.م</span></div>`).join('')}
            <div style="display:flex;justify-content:space-between;font-size:12.5px;font-weight:900;padding-top:8px;margin-top:6px;border-top:1px dashed var(--border);color:var(--maroon);">
                <span>الإجمالي</span><span>${money(getCartTotal())} ج.م</span>
            </div>
        </div>`;
    setDeliveryTime(deliveryTime);
}
function setDeliveryTime(t){
    deliveryTime = t;
    document.getElementById('deliveryMorningBtn').style.background = t==='morning' ? 'var(--maroon)' : 'var(--sand)';
    document.getElementById('deliveryMorningBtn').style.color = t==='morning' ? 'var(--cream)' : 'var(--maroon)';
    document.getElementById('deliveryEveningBtn').style.background = t==='evening' ? 'var(--maroon)' : 'var(--sand)';
    document.getElementById('deliveryEveningBtn').style.color = t==='evening' ? 'var(--cream)' : 'var(--maroon)';
}
function proceedToConfirmOrder(){
    if (!customerProfile || !customerProfile.customerName || !customerProfile.shopName || !customerProfile.addressDetail){
        document.getElementById('profCustomerName').value = customerProfile?.customerName || '';
        document.getElementById('profShopName').value = customerProfile?.shopName || '';
        document.getElementById('profAddress').value = customerProfile?.addressDetail || '';
        switchScreen('profile');
        return;
    }
    sendOrderToServer();
}
function pinLocation(){
    const btn = document.getElementById('profMapBtn');
    btn.classList.add('pinned');
    btn.querySelector('span').textContent = 'تم تحديد الموقع بنجاح ✓';
    btn.dataset.pinned = '1';
}
function submitProfile(){
    const customerName = document.getElementById('profCustomerName').value.trim();
    const shopName = document.getElementById('profShopName').value.trim();
    const addressDetail = document.getElementById('profAddress').value.trim();
    const pinned = document.getElementById('profMapBtn').dataset.pinned === '1';
    if (!customerName || !shopName || !addressDetail || !pinned){
        showToast('من فضلك أكمل كل البيانات وحدد الموقع'); return;
    }
    customerProfile = { customerName, shopName, addressDetail, pinned: true };
    localStorage.setItem('app_customer_profile', JSON.stringify(customerProfile));
    document.getElementById('welcomeName').textContent = customerName;
    document.getElementById('accountCustomerName').textContent = customerName;
    sendOrderToServer();
}

function sendOrderToServer(){
    const lines = getCartLineItems();
    if (lines.length === 0) return;
    showLoading(true);
    const items = lines.map(l => ({
        productCode: l.product.code, productName: l.product.name,
        unit: l.unitLabel, qty: l.entry.qty, price: l.unitPrice, total: l.lineTotal
    }));
    const order = {
        customerCode: customerPhone,
        customerName: customerProfile.customerName,
        shopName: customerProfile.shopName,
        addressDetail: customerProfile.addressDetail,
        phone: customerPhone,
        deliveryTime: deliveryTime,
        items: items,
        total: getCartTotal(),
        status: 'pending',
        createdAt: Date.now()
    };
    db.collection('customerOrders').add(order).then(function(){
        lastOrderItems = JSON.parse(JSON.stringify(cart));
        localStorage.setItem('app_last_order', JSON.stringify(lastOrderItems));
        cart = {};
        localStorage.setItem('app_cart', '{}');
        updateCartBadge();
        showLoading(false);
        showToast('تم إرسال الطلب بنجاح ✓');
        switchTopTab('home'); switchScreen('home');
    }).catch(function(err){
        console.error(err);
        showLoading(false);
        showToast('تعذر إرسال الطلب، تأكد من الإنترنت وحاول تاني');
    });
}

/* =========================================================================
   طلباتي
   ========================================================================= */
const STATUS_LABELS = { pending: ['قيد المراجعة', 'status-pending'], fulfilled: ['تم التجهيز والتوصيل', 'status-fulfilled'], rejected: ['مرفوض', 'status-rejected'] };
function renderOrders(){
    const wrap = document.getElementById('ordersList');
    if (myOrders.length === 0){ wrap.innerHTML = `<div class="empty-note">لسه معملتش أي طلبات</div>`; return; }
    wrap.innerHTML = myOrders.map(o => {
        const [label, cls] = STATUS_LABELS[o.status] || STATUS_LABELS.pending;
        const summary = (o.items||[]).map(i => `${i.productName} × ${i.qty}`).join('، ');
        const dateStr = o.createdAt ? new Date(o.createdAt).toLocaleString('ar-EG') : '-';
        return `<div class="order-card">
            <div class="order-top"><span class="order-id">طلب #${o.id.slice(-6)}</span><span class="order-date">${dateStr}</span></div>
            <div class="order-summary">${summary} — <strong style="color:var(--maroon);">${money(o.total)} ج.م</strong></div>
            <span class="status-badge ${cls}">${label}</span>
            ${o.status === 'fulfilled' ? `<button class="action-btn" style="margin-top:10px;" onclick="openRatingModal('${o.id}')"><i class="fas fa-star"></i> قيّم الطلب</button>` : ''}
        </div>`;
    }).join('');
}

/* =========================================================================
   تقييم الطلب
   ========================================================================= */
function openRatingModal(orderId){
    currentRatingOrderId = orderId; currentRatingStars = 5;
    document.getElementById('ratingComment').value = '';
    paintStars();
    document.getElementById('ratingModal').classList.add('show');
}
function closeRatingModal(){ document.getElementById('ratingModal').classList.remove('show'); }
function paintStars(){
    document.querySelectorAll('#ratingStars i').forEach(el => {
        el.classList.toggle('filled', Number(el.dataset.star) <= currentRatingStars);
    });
}
document.getElementById('ratingStars').addEventListener('click', function(e){
    const star = e.target.closest('[data-star]');
    if (!star) return;
    currentRatingStars = Number(star.dataset.star);
    paintStars();
});
function submitRating(){
    const comment = document.getElementById('ratingComment').value.trim();
    db.collection('customerOrders').doc(currentRatingOrderId).update({
        rating: { stars: currentRatingStars, comment, ratedAt: Date.now() }
    }).then(function(){
        closeRatingModal();
        showToast('شكرًا لتقييمك ✓');
    }).catch(function(){ showToast('تعذر إرسال التقييم'); });
}

/* =========================================================================
   بدء التشغيل
   ========================================================================= */
if (customerPhone){ startApp(); }

if ('serviceWorker' in navigator){
    window.addEventListener('load', () => { navigator.serviceWorker.register('./sw.js').catch(()=>{}); });
}
</script>
