</div>

<!-- ============== MAIN APP ============== -->
<div id="appRoot" class="hidden">
  <div class="top-tabs">
    <button class="top-tab" data-toptab="orders" onclick="switchTopTab('orders')">طلباتي</button>
    <button class="top-tab" data-toptab="account" onclick="switchTopTab('account')">حسابي</button>
    <button class="top-tab active" data-toptab="home" onclick="switchTopTab('home')">الرئيسية</button>
  </div>

  <!-- HOME -->
  <div id="homeScreen" class="screen active">
    <div class="welcome-card">
      <div class="welcome-row">
        <div class="avatar-badge">م</div>
