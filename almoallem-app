<style>
  :root{
    --maroon:#7A1F1F; --maroon-dark:#5E1414; --gold:#D4A017; --cream:#FBF3E7;
    --sand:#F3E4CB; --card:#FFFDF9; --border:#F0E4CE; --ink:#3B2417; --muted:#8a7460;
    --danger:#B23A2E; --success:#2E7D42;
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
  body{margin:0;font-family:'Tajawal',sans-serif;background:var(--cream);color:var(--ink);
       max-width:480px;margin:0 auto;min-height:100vh;-webkit-user-select:none;user-select:none;}
  input,textarea{-webkit-user-select:text;user-select:text;}
  button{font-family:inherit;border:none;cursor:pointer;background:none;color:inherit;}
  img{max-width:100%;display:block;}
  .screen{display:none;min-height:100vh;flex-direction:column;padding-bottom:70px;}
  .screen.active{display:flex;}
  .hidden{display:none !important;}

  /* ===== Login ===== */
  #loginScreen{align-items:center;justify-content:center;text-align:center;padding:32px 24px;min-height:100vh;}
  .logo-badge{width:84px;height:84px;border-radius:22px;background:linear-gradient(150deg,var(--maroon),var(--maroon-dark));
    display:flex;align-items:center;justify-content:center;font-size:34px;font-weight:900;color:var(--gold);
    box-shadow:0 8px 24px rgba(122,31,31,0.25);margin-bottom:18px;}
  .login-input{width:100%;padding:15px 16px;border-radius:16px;border:1px solid var(--border);background:var(--card);
    font-size:15px;font-weight:700;text-align:center;direction:ltr;margin-bottom:14px;}
  .btn-primary{width:100%;padding:15px;border-radius:16px;background:linear-gradient(150deg,var(--maroon),var(--maroon-dark));
    color:var(--cream);font-weight:800;font-size:14px;}
  .btn-primary:disabled{opacity:0.4;}

  /* ===== Top tabs ===== */
  .top-tabs{display:flex;gap:6px;margin:12px 16px 8px;padding:4px;border-radius:16px;background:var(--sand);}
  .top-tab{flex:1;padding:10px;border-radius:12px;font-size:12px;font-weight:800;color:var(--muted);}
  .top-tab.active{background:linear-gradient(150deg,var(--maroon),var(--maroon-dark));color:var(--cream);box-shadow:0 2px 8px rgba(107,20,20,0.3);}

  /* ===== Welcome card ===== */
  .welcome-card{margin:0 16px;border-radius:20px;padding:14px;background:linear-gradient(135deg,#8B2424,#5E1414);position:relative;overflow:hidden;}
  .welcome-card::before{content:'';position:absolute;left:-24px;top:-30px;width:110px;height:110px;border-radius:50%;background:rgba(212,160,23,0.15);}
  .welcome-row{position:relative;display:flex;align-items:center;gap:10px;}
  .avatar-badge{width:38px;height:38px;border-radius:50%;background:var(--gold);color:var(--ink);display:flex;align-items:center;justify-content:center;font-weight:900;flex-shrink:0;}
  .welcome-name{font-size:13px;font-weight:800;color:var(--cream);}
  .welcome-sub{font-size:10px;color:#E3B9B0;}

  /* ===== Search ===== */
  .search-bar{margin:12px 16px 0;display:flex;align-items:center;gap:8px;background:var(--card);border:1px solid var(--border);
    border-radius:16px;padding:12px 14px;}
  .search-bar input{border:none;background:none;flex:1;font-size:12px;font-weight:600;color:var(--ink);outline:none;}

  /* ===== Section headers ===== */
  .section-head{display:flex;align-items:center;gap:8px;margin:20px 16px 12px;}
  .section-bar{width:4px;height:16px;border-radius:2px;background:var(--maroon);}
  .section-title{font-size:13px;font-weight:800;}

  /* ===== Ad banner ===== */
  .ad-banner{margin:14px 16px 0;border-radius:18px;padding:16px;height:88px;display:flex;flex-direction:column;justify-content:center;
    position:relative;overflow:hidden;color:var(--cream);}
  .ad-banner::before{content:'';position:absolute;left:-16px;bottom:-24px;width:80px;height:80px;border-radius:50%;background:rgba(255,255,255,0.15);}
  .ad-title{position:relative;font-size:13px;font-weight:800;}
  .ad-sub{position:relative;font-size:10px;margin-top:4px;opacity:0.9;}
  .ad-dots{display:flex;justify-content:center;gap:6px;margin-top:8px;}
  .ad-dot{width:5px;height:5px;border-radius:50%;background:var(--border);}
  .ad-dot.active{width:14px;background:var(--maroon);}

  /* ===== Grids ===== */
  .cat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:0 16px;}
  .cat-tile{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:10px;display:flex;flex-direction:column;
    align-items:center;gap:6px;box-shadow:0 1px 4px rgba(59,36,23,0.04);}
  .cat-img{width:100%;height:56px;border-radius:12px;object-fit:cover;background:var(--sand);}
  .cat-icon{width:100%;height:56px;border-radius:12px;display:flex;align-items:center;justify-content:center;background:var(--sand);color:var(--maroon);font-size:20px;}
  .cat-name{font-size:10px;font-weight:800;text-align:center;line-height:1.3;}

  .brand-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:0 16px 24px;}
  .brand-tile{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:10px;display:flex;flex-direction:column;align-items:center;gap:6px;}
  .brand-tile.all{background:linear-gradient(150deg,var(--maroon),var(--maroon-dark));border:none;}
  .brand-logo{width:100%;height:56px;border-radius:12px;object-fit:cover;}
  .brand-logo-fallback{width:100%;height:56px;border-radius:12px;display:flex;align-items:center;justify-content:center;
    background:var(--sand);color:var(--maroon);font-weight:900;font-size:15px;}
  .brand-name{font-size:10px;font-weight:800;text-align:center;color:var(--ink);}
  .brand-tile.all .brand-name{color:var(--cream);}
  .brand-count{font-size:8px;color:var(--muted);}

  .prod-row{display:flex;gap:10px;margin:0 16px;overflow-x:auto;padding-bottom:4px;}
  .prod-row::-webkit-scrollbar{display:none;}
  .prod-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:0 16px;}

  /* ===== Product card ===== */
  .pcard{background:var(--card);border:1px solid var(--border);border-radius:22px;overflow:hidden;box-shadow:0 1px 4px rgba(59,36,23,0.05);
    position:relative;flex-shrink:0;width:100%;}
  .prod-row .pcard{width:140px;}
  .pcard.oos{opacity:0.6;}
  .pcard-fav{position:absolute;top:12px;left:12px;z-index:2;width:24px;height:24px;border-radius:50%;background:rgba(255,253,249,0.92);
    display:flex;align-items:center;justify-content:center;font-size:11px;color:var(--muted);}
  .pcard-fav.active{color:var(--gold);}
  .pcard-img-wrap{position:relative;padding:10px 10px 0;}
  .pcard-img{width:100%;height:96px;border-radius:16px;object-fit:cover;background:var(--sand);}
  .pcard-img-fallback{width:100%;height:96px;border-radius:16px;display:flex;align-items:center;justify-content:center;background:var(--sand);color:var(--maroon);font-size:26px;}
  .pcard-badge{position:absolute;top:12px;right:12px;padding:2px 8px;border-radius:99px;font-size:9px;font-weight:800;}
  .pcard-badge.oos{background:var(--ink);color:var(--cream);}
  .pcard-badge.low{background:var(--gold);color:var(--ink);}
  .pcard-add{position:absolute;bottom:-12px;right:16px;width:36px;height:36px;border-radius:50%;background:linear-gradient(150deg,var(--maroon),var(--maroon-dark));
    color:var(--cream);display:flex;align-items:center;justify-content:center;font-size:15px;box-shadow:0 4px 10px rgba(107,20,20,0.35);}
  .pcard-add:disabled{background:#B7A88E;}
  .pcard-stepper{position:absolute;bottom:-12px;left:12px;right:12px;background:linear-gradient(150deg,var(--maroon),var(--maroon-dark));
    border-radius:99px;display:flex;align-items:center;justify-content:space-between;padding:5px;box-shadow:0 4px 10px rgba(107,20,20,0.35);}
  .pcard-stepper button{width:24px;height:24px;border-radius:50%;color:var(--cream);display:flex;align-items:center;justify-content:center;}
  .pcard-stepper .qty{color:var(--cream);font-weight:800;font-size:12px;}
  .pcard-body{padding:16px 10px 10px;}
  .pcard-price{font-size:15px;font-weight:900;}
  .pcard-price .cur{font-size:9px;font-weight:700;color:var(--muted);margin-right:2px;}
  .pcard-unit{font-size:9px;color:#B7935F;font-weight:700;margin-bottom:4px;}
  .pcard-name{font-size:10.5px;font-weight:700;line-height:1.4;color:#5B4432;}
  .pcard-units{display:flex;gap:4px;margin-top:8px;}
  .pcard-unit-btn{flex:1;font-size:9px;font-weight:800;padding:5px;border-radius:8px;border:1px solid var(--border);color:var(--maroon);}
  .pcard-unit-btn.active{background:var(--sand);}

  /* ===== Buttons/pills ===== */
  .pill-row{display:flex;gap:6px;margin:0 16px 8px;overflow-x:auto;padding-bottom:2px;}
  .pill-row::-webkit-scrollbar{display:none;}
  .pill{flex-shrink:0;padding:7px 14px;border-radius:99px;font-size:10.5px;font-weight:800;background:var(--sand);color:#5B4432;white-space:nowrap;}
  .pill.active{background:var(--maroon);color:var(--cream);}

  .action-btn{width:100%;padding:12px;border-radius:16px;font-size:12px;font-weight:800;background:var(--sand);color:var(--maroon);
    display:flex;align-items:center;justify-content:center;gap:6px;box-shadow:0 1px 4px rgba(59,36,23,0.04);}
  .row-2{display:flex;gap:10px;margin:14px 16px 0;}
  .row-2 > *{flex:1;}

  /* ===== Header w/ back ===== */
  .header-row{display:flex;align-items:center;gap:10px;padding:14px 16px 8px;}
  .back-btn{width:32px;height:32px;border-radius:50%;background:var(--sand);color:var(--maroon);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
  .header-title{font-size:13px;font-weight:800;}
  .header-dark{background:linear-gradient(150deg,var(--maroon),var(--maroon-dark));}
  .header-dark .header-title{color:var(--cream);}
  .header-dark .back-btn{background:rgba(255,255,255,0.15);color:var(--cream);}

  /* ===== Cart ===== */
  .cart-item{margin:0 16px 10px;background:var(--card);border:1px solid var(--border);border-radius:18px;padding:10px;display:flex;gap:10px;align-items:center;}
  .cart-item img,.cart-item .fallback{width:60px;height:60px;border-radius:14px;object-fit:cover;flex-shrink:0;}
  .cart-item .fallback{display:flex;align-items:center;justify-content:center;background:var(--sand);color:var(--maroon);font-size:20px;}
  .cart-item-info{flex:1;min-width:0;}
  .cart-item-name{font-size:11.5px;font-weight:700;margin-bottom:2px;}
  .cart-item-unit{font-size:9.5px;color:var(--muted);margin-bottom:6px;}
  .cart-stepper{display:inline-flex;align-items:center;gap:8px;background:var(--sand);border-radius:99px;padding:4px;}
  .cart-stepper button{width:22px;height:22px;border-radius:50%;background:var(--card);color:var(--maroon);display:flex;align-items:center;justify-content:center;font-size:10px;}
  .cart-item-price{font-size:11.5px;font-weight:800;color:var(--maroon);white-space:nowrap;}
  .cart-item-remove{color:var(--danger);padding:4px;}

  .cart-footer{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:480px;background:var(--sand);
    padding:12px 16px calc(12px + env(safe-area-inset-bottom));box-shadow:0 -4px 16px rgba(59,36,23,0.08);}

  /* ===== Bottom nav ===== */
  .bottom-nav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:480px;height:64px;background:var(--card);
    border-top:1px solid var(--border);display:flex;align-items:center;justify-content:space-around;
    padding-bottom:env(safe-area-inset-bottom);z-index:40;}
  .nav-btn{display:flex;flex-direction:column;align-items:center;gap:2px;padding:8px 14px;border-radius:14px;position:relative;color:#B7A88E;}
  .nav-btn.active{background:var(--sand);color:var(--maroon);}
  .nav-btn i{font-size:16px;}
  .nav-btn span{font-size:9px;font-weight:800;}
  .nav-badge{position:absolute;top:2px;left:8px;background:var(--gold);color:var(--ink);border-radius:50%;
    width:16px;height:16px;font-size:9px;font-weight:800;display:flex;align-items:center;justify-content:center;}

  /* ===== Forms ===== */
  .form-group{margin:0 16px 14px;}
  .form-label{font-size:11px;font-weight:800;margin-bottom:6px;display:block;color:#5B4432;}
  .form-input,.form-textarea,.form-select{width:100%;padding:12px 14px;border-radius:14px;border:1px solid var(--border);
    background:var(--card);font-size:12px;font-weight:600;font-family:inherit;color:var(--ink);}
  .form-textarea{resize:none;}
  .map-btn{width:100%;padding:13px;border-radius:14px;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center;gap:8px;
    background:var(--sand);color:var(--maroon);}
  .map-btn.pinned{background:#E9F5EC;color:var(--success);}

  /* ===== Order card ===== */
  .order-card{margin:0 16px 12px;background:var(--card);border:1px solid var(--border);border-radius:18px;padding:14px;}
  .order-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;}
  .order-id{font-size:12px;font-weight:800;}
  .order-date{font-size:9.5px;color:var(--muted);}
  .order-summary{font-size:10.5px;color:#5B4432;margin-bottom:10px;line-height:1.5;}
  .status-badge{display:inline-block;padding:4px 10px;border-radius:99px;font-size:10px;font-weight:800;}
  .status-pending{background:#FBE9C6;color:#8a6a12;}
  .status-fulfilled{background:#DDF0E1;color:var(--success);}
  .status-rejected{background:#FBE3C9;color:var(--danger);}

  /* ===== Toast ===== */
  #toast{position:fixed;top:16px;left:50%;transform:translateX(-50%);background:#241512;color:var(--cream);
    padding:10px 18px;border-radius:99px;font-size:11.5px;font-weight:800;z-index:100;opacity:0;transition:opacity 0.25s;
    max-width:90%;text-align:center;pointer-events:none;}
  #toast.show{opacity:1;}

  /* ===== Modal ===== */
  .modal-overlay{position:fixed;inset:0;background:rgba(36,21,18,0.5);z-index:90;display:none;align-items:flex-end;justify-content:center;}
  .modal-overlay.show{display:flex;}
  .modal-sheet{width:100%;max-width:480px;background:var(--cream);border-radius:24px 24px 0 0;padding:20px;max-height:85vh;overflow-y:auto;}

  .empty-note{text-align:center;padding:50px 20px;font-size:11.5px;color:var(--muted);line-height:1.7;}
  .star-row{display:flex;justify-content:center;gap:6px;margin:14px 0;}
  .star-row i{font-size:26px;color:var(--border);cursor:pointer;}
  .star-row i.filled{color:var(--gold);}

  .spinner{width:34px;height:34px;border:3px solid var(--sand);border-top-color:var(--maroon);border-radius:50%;
    animation:spin 0.8s linear infinite;margin:60px auto;}
  @keyframes spin{to{transform:rotate(360deg);}}
</style>
</head>
